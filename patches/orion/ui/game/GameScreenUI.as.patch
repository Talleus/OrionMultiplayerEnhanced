+            return;
+         }
+         var prefix:String = txt.split(/\s+/)[0].toLowerCase();
+         var matches:Array = [];
+         var i:int = 0;
+         while(i < AVAILABLE_COMMANDS.length)
+         {
+            var cmd:String = String(AVAILABLE_COMMANDS[i]);
+            if(cmd.indexOf(prefix) == 0)
+            {
+               var usage:String = String(COMMAND_USAGE[cmd]);
+               matches.push(usage != null ? usage : cmd);
+            }
+            i++;
+         }
+         if(matches.length == 0)
+         {
+            this._commandHintPanel.visible = false;
+            return;
+         }
+         this._commandHintText.text = matches.join("\n");
+         var lineCount:int = int(matches.length);
+         var hintH:Number = Math.max(26,lineCount * 18 + 8);
+         var hintW:Number = 430;
+         this._commandHintPanel.graphics.clear();
+         this._commandHintPanel.graphics.beginFill(662560,0.92);
+         this._commandHintPanel.graphics.drawRoundRect(0,0,hintW,hintH,6,6);
+         this._commandHintPanel.graphics.endFill();
