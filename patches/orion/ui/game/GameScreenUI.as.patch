+      private function updateXray() : void
+      {
+         if(this._xrayOverlay == null || Context.world == null || Context.world.tiles == null || Context.game == null)
+         {
+            return;
+         }
+         var scr:OrionScreen = Context.game.screen;
+         if(scr == null)
+         {
+            return;
+         }
+         this._xrayOverlay.visible = true;
+         this._xrayOverlay.graphics.clear();
+         var startX:int = Math.max(0,scr.tileX - 1);
+         var endX:int = Math.min(Context.world.tilesX - 1,scr.endTileX + 1);
+         var startY:int = Math.max(0,scr.tileY - 1);
+         var endY:int = Math.min(Context.world.tilesY - 1,scr.endTileY + 1);
+         var zoom:Number = OrionScreen.currentZoom;
+         var tileSize:Number = 32 * zoom;
+         var ty:int = startY;
