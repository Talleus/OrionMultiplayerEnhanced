+      private function autocompleteCommand() : void
+      {
+         if(this._gameChatInput == null)
+         {
+            return;
+         }
+         var txt:String = this._gameChatInput.text;
+         if(txt.length == 0 || txt.charAt(0) != "/")
+         {
+            return;
+         }
+         var parts:Array = txt.split(/\s+/);
+         if(parts.length <= 1)
+         {
+            var prefix:String = String(parts[0]).toLowerCase();
+            var i:int = 0;
+            while(i < AVAILABLE_COMMANDS.length)
+            {
+               var cmd:String = String(AVAILABLE_COMMANDS[i]);
+               if(cmd.indexOf(prefix) == 0)
+               {
+                  this._gameChatInput.text = cmd + " ";
+                  var len:int = this._gameChatInput.text.length;
+                  this._gameChatInput.setSelection(len,len);
+                  this.updateCommandHints();
+                  return;
+               }
+               i++;
+            }
+         }
+      }
