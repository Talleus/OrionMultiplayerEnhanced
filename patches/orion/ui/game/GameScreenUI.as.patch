+         this._commandHintPanel.graphics.drawRoundRect(0,0,hintW,hintH,6,6);
+         this._commandHintText.height = hintH - 6;
+         this._commandHintPanel.y = 132 - hintH - 4;
+         this._commandHintPanel.visible = true;
+      }
